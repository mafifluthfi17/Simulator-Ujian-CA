          {
            "criterionId": "C4",
            "description": "Kualitas argumentasi",
            "maxScore": 2,
            "full": "Argumen runtut dan menyimpulkan rekomendasi yang jelas.",
            "partial": "Argumen ada tetapi kurang runtut.",
