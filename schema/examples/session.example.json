        "competencyIds": [
          "K02"
        ],
        "difficulty": "sedang",
        "cognitiveLevel": "C3",
        "estimatedMinutes": 2,
        "maxScore": 1,
        "stem": "[CONTOH] Divisi Logistik PT Arunika Niaga (fiktif) mencatat laba operasi setelah pajak Rp180 miliar, modal yang diinvestasikan Rp1.200 miliar, dan WACC 11%. Berapa Economic Value Added (EVA) divisi tersebut dalam Rp miliar?",
        "numericAnswer": {
          "value": 48,
          "unit": "Rp miliar",
          "tolerance": {
            "type": "relative",
            "value": 0.01
          }
        },
        "explanation": "EVA = NOPAT - (WACC x modal diinvestasikan) = 180 - (11% x 1.200) = 180 - 132 = 48.",
        "references": [
          "Economic Value Added"
        ],
        "lifecycle": {
          "status": "LIVE",
          "contentHash": "2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae",
          "review": null,
          "approvedBy": "LMA",
