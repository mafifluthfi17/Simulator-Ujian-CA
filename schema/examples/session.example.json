          "K01"
        ],
        "difficulty": "sedang",
        "cognitiveLevel": "C4",
        "estimatedMinutes": 1.5,
        "maxScore": 1,
        "stem": "[CONTOH] PT Rasa Laut Lestari (fiktif), produsen ikan kaleng, menetapkan sasaran \"meningkatkan loyalitas pelanggan ritel modern\". Dalam strategy map balanced scorecard, sasaran manakah yang paling tepat ditempatkan sebagai penggerak langsung sasaran tersebut?",
        "options": [
          {
            "key": "A",
            "text": "Menurunkan biaya produksi per kaleng sebesar 5%"
          },
          {
            "key": "B",
            "text": "Meningkatkan kompetensi digital tenaga penjual"
          },
          {
            "key": "C",
            "text": "Meningkatkan ketepatan waktu pengiriman ke gerai ritel modern"
          },
          {
            "key": "D",
            "text": "Meningkatkan laba bersih per saham"
          }
        ],
        "answerKey": "C",
        "distractorRationale": {
          "A": "Efisiensi biaya berada di perspektif keuangan/proses dan tidak langsung dirasakan pelanggan ritel.",
          "B": "Kompetensi karyawan adalah penggerak di perspektif pembelajaran dan pertumbuhan, dua tingkat di bawah sasaran pelanggan.",
          "D": "Laba per saham adalah hasil akhir perspektif keuangan, bukan penggerak loyalitas pelanggan."
        },
        "explanation": "Dalam strategy map, sasaran pelanggan digerakkan langsung oleh sasaran proses bisnis internal. Ketepatan pengiriman adalah proses internal yang langsung memengaruhi pengalaman gerai ritel.",
        "references": [
          "Balanced scorecard dan strategy map"
        ],
        "lifecycle": {
