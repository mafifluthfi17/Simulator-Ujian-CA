      "questionId": "CTH-NUM-001",
      "type": "numeric",
      "contentHash": "2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae",
      "originalMaxScore": 1,
      "points": 20,
      "scaleFactor": 20,
      "question": {
        "id": "CTH-NUM-001",
        "type": "numeric",
        "topicIds": [
          "T03"
