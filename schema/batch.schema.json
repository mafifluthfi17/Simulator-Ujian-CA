{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch.schema.json",
  "title": "Batch soal dari penyusun AI (SPEC 5.3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["batchType", "schemaVersion", "subjectId", "batchId", "items"],
  "properties": {
    "batchType": { "const": "soal" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "subjectId": { "$ref": "common.schema.json#/$defs/subjectId" },
    "batchId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-B[0-9]{2,}$" },
    "items": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "allOf": [
          { "$ref": "question.schema.json" },
          {
            "$comment": "Soal dari AI selalu DRAFT (atau CALIBRATION), tanpa hash, tanpa review/persetujuan.",
            "properties": {
              "lifecycle": {
                "properties": {
                  "status": { "enum": ["DRAFT", "CALIBRATION"] },
                  "contentHash": { "const": "" },
                  "review": { "type": "null" },
                  "approvedBy": { "type": "null" },
                  "approvedAt": { "type": "null" },
                  "history": false
                }
              }
            }
          }
        ]
      }
    }
  }
}
