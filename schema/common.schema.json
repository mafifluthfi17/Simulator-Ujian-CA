{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Definisi bersama kontrak data Simulator Ujian CA v4.1",
  "$comment": "Pustaka $defs saja; tidak memvalidasi dokumen secara langsung.",
  "$defs": {
    "schemaVersion": { "const": "4.1" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "subjectId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" },
    "questionId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[A-Z]+-[0-9]{3,}$",
      "description": "Contoh: MSK-MCQ-001. Lihat DECISIONS.md untuk prefiks tipe."
    },
    "topicId": { "type": "string", "pattern": "^T[0-9]{2}$" },
    "competencyId": { "type": "string", "pattern": "^K[0-9]{2}$" },
    "criterionId": { "type": "string", "pattern": "^C[0-9]{1,2}$" },
    "subQuestionId": { "type": "string", "pattern": "^[a-z]$" },
    "sessionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
    "packageId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,15}$" },
    "questionType": { "enum": ["mcq", "essay", "case", "numeric"] },
    "caseSize": { "enum": ["mini", "komprehensif"] },
    "difficulty": { "enum": ["mudah", "sedang", "sulit", "sangat_sulit"] },
    "cognitiveLevel": { "enum": ["C2", "C3", "C4", "C5", "C6"] },
    "optionKey": { "enum": ["A", "B", "C", "D"] },
    "confidence": { "enum": ["tinggi", "sedang", "rendah"] },
    "verdict": { "enum": ["APPROVE", "REVISE", "REJECT"] },
    "dimensionName": {
      "enum": [
        "keyCorrectness", "singleBestAnswer", "stemClarity", "distractorQuality",
        "rubricQuality", "dataConsistency", "alignment", "timeEstimate",
        "originality", "fairness"
      ]
    },
    "lifecycleStatus": {
      "enum": [
        "DRAFT", "AI_REVIEWED", "APPROVED", "LIVE",
        "NEEDS_REVISION", "REJECTED", "RETIRED", "CALIBRATION"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "multipleOf": 0.5,
      "description": "Skor skala asli, kelipatan 0,5."
    },
    "positiveScore": { "type": "number", "exclusiveMinimum": 0, "multipleOf": 0.5 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "date": { "type": "string", "format": "date" },
    "dateTime": { "type": "string", "format": "date-time" },
    "nullableDateTime": {
      "anyOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }]
    }
  }
}
